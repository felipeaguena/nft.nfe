# ==============================================================================
# ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# ATENÇÃO (DevSecOps):
# - NUNCA comite arquivos .env reais no repositório Git.
# - NUNCA utilize prefixos públicos (NEXT_PUBLIC_ ou VITE_) em chaves privadas!
# - Copie este arquivo para `.env` localmente ou configure as variáveis no painel da Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Autenticação & Auth.js (Camada Web / Vercel)
# ------------------------------------------------------------------------------
# Chave secreta obrigatória para assinatura/criptografia de tokens JWE/JWT e cookies de sessão.
# Gere com: openssl rand -base64 32
AUTH_SECRET="gere-um-segredo-forte-com-pelo-menos-32-bytes-aqui"

# Credenciais de Administrador para login (a senha deve ser armazenada em hash bcrypt em produção)
AUTH_ADMIN_EMAIL="admin@nftlogistics.com.br"
AUTH_ADMIN_PASSWORD_HASH="$2b$12$ExemploDeHashBcryptSeguroParaProducao1234567890123456"

# ------------------------------------------------------------------------------
# 2. Segurança da Camada Python (Flask / API)
# ------------------------------------------------------------------------------
# Ambiente de execução ('production' na Vercel para desativar debug=True e forçar cookies Secure)
FLASK_ENV="production"
FLASK_DEBUG="0"
FLASK_SECRET_KEY="gere-uma-chave-secreta-exclusiva-para-o-flask"

# Origem permitida no CORS (NUNCA usar '*' com credenciais em produção)
# Em desenvolvimento local: http://localhost:1652 ou http://localhost:3000
# Na Vercel: https://seu-dominio-na-vercel.vercel.app
ALLOWED_ORIGIN="http://localhost:1652"

# Chave secreta Server-to-Server para comunicação interna entre camadas (Header X-Internal-API-Key)
INTERNAL_API_KEY="gere-uma-chave-interna-server-to-server-forte"

# Ativar proteção obrigatória de autenticação nas rotas privadas da API Python
# Em produção na Vercel, mantenha "true". Para uso desktop local sem tela de login, pode ser "false" se desejar, ou "true" usando login web.
ENFORCE_API_AUTH="true"

# ------------------------------------------------------------------------------
# 3. Certificados Digitais (A1 - ICP-Brasil) & SEFAZ / Siscomex
# ------------------------------------------------------------------------------
# Caminho e senha do Certificado e-CNPJ padrão (SEFAZ / NF-e)
# Em ambiente local use o caminho do arquivo:
CERT_PFX_PATH="gerador/certificado/NFT_LOGISTICS_LTDA_47998441000198_1771873069312658700_nftcnpj.pfx"
CERT_PFX_PASSWORD="sua-senha-do-certificado"

# Na Vercel (Produção), converta o .pfx em base64 e cole na variável:
# Exemplo no PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("caminho_do_certificado.pfx")) | Set-Clipboard
CERT_PFX_BASE64=""

# Caminho e senha do Certificado e-CPF (Portal Único Siscomex / PUCOMEX)
ECPF_PFX_PATH="gerador/certificado/felipe_ecpf.pfx"
ECPF_PFX_PASSWORD=""

# ------------------------------------------------------------------------------
# 4. Integrações Externas & Dados Padrão do Emitente
# ------------------------------------------------------------------------------
# URL da planilha Google Sheets para sincronização de Feiras
FEIRAS_GOOGLE_SHEETS_URL="https://docs.google.com/spreadsheets/d/SEU_SHEET_ID_AQUI/edit?gid=0"

# Dados fiscais padrão do Emitente (Fallback caso o banco de dados esteja vazio)
EMITENTE_PADRAO_CNPJ="47998441000198"
EMITENTE_PADRAO_IE="138843326117"
EMITENTE_PADRAO_NOME="NFT LOGISTICS LTDA"
